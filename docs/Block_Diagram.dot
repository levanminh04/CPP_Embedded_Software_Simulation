digraph SoDoKhoiDenGiaoThong {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.75"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#334155", fillcolor="#F8FAFC", margin="0.16,0.10"];
  edge [fontname="Arial", fontsize=9, color="#475569", arrowsize=0.75];

  input [label="Đầu vào / Sự kiện\nBàn phím hoặc kịch bản\nP, E, lệnh thoát khẩn cấp", fillcolor="#DBEAFE"];
  sensor [label="Bộ giả lập sensor giao thông\nSố xe NS/EW giả lập\nKiểm tra mẫu đọc", fillcolor="#DBEAFE"];
  config [label="Cấu hình\nThời lượng và ngưỡng\nKiểm tra lúc khởi động", fillcolor="#FEF3C7"];
  timer [label="Timer / Bộ định thời\nNhịp chrono và sleep", fillcolor="#FEF3C7"];
  controller [label="Bộ điều khiển giao thông\nMáy trạng thái, ưu tiên, an toàn\nTrạng thái tiếp theo và lệnh đèn", fillcolor="#DCFCE7", penwidth=2];
  output [label="Đầu ra / Actuator\nĐổi quyết định thành đèn", fillcolor="#EDE9FE"];
  display [label="Hiển thị console\nĐèn, state, countdown", fillcolor="#FCE7F3"];
  logger [label="Bộ ghi log\nGhi system.log bằng fstream", fillcolor="#FCE7F3"];
  app [label="Bộ điều phối / Vòng lặp điều khiển\nđọc -> quyết định -> cập nhật\nhiển thị/log -> chờ", fillcolor="#E2E8F0"];

  {rank=same; input; sensor; config; timer}
  {rank=same; display; logger}

  app -> input [label="đọc lệnh"];
  app -> sensor [label="lấy mẫu"];
  app -> timer [label="lấy nhịp"];
  config -> controller [label="thiết lập hợp lệ"];
  input -> controller [label="sự kiện"];
  sensor -> controller [label="số xe hợp lệ"];
  timer -> controller [label="thời gian đã trôi"];
  controller -> output [label="lệnh đèn"];
  output -> display [label="trạng thái đèn"];
  controller -> display [label="state / thời gian còn lại"];
  controller -> logger [label="chuyển state / sự kiện / lỗi"];
  sensor -> logger [label="lỗi sensor"];
  config -> logger [label="lỗi cấu hình"];
}
