digraph SoDoTrangThaiDenGiaoThong {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.50", labelloc="t", label="Bộ điều khiển đèn giao thông - Sơ đồ trạng thái nghiệp vụ", fontname="Arial", fontsize=18];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#334155", fillcolor="#F8FAFC", margin="0.16,0.10"];
  edge [fontname="Arial", fontsize=9, color="#475569", arrowsize=0.75];

  start [shape=point, width=0.15, label=""];
  startup [label="Khởi động ALL-RED\ntất cả đèn RED\nlượt xe kế tiếp = NS", fillcolor="#FEE2E2"];
  green [label="Xe GREEN\nchọn NS hoặc EW\nthời lượng hữu hạn", fillcolor="#DCFCE7"];
  yellow [label="Xe YELLOW\ncùng hướng đang chạy\nbắt đầu clearance", fillcolor="#FEF3C7"];
  allred [label="Điểm quyết định ALL-RED\ntất cả đèn RED", fillcolor="#FEE2E2"];
  emergencyDecision [shape=diamond, label="Có Emergency\nđang chờ?", fillcolor="#FFE4E6"];
  pedestrianDecision [shape=diamond, label="Có yêu cầu\nngười đi bộ?", fillcolor="#DBEAFE"];
  walk [label="Người đi bộ WALK\nxe đều RED\nngười đi bộ GREEN", fillcolor="#DCFCE7"];
  warning [label="Người đi bộ WARNING\nxe đều RED", fillcolor="#FEF3C7"];
  emergency [label="EMERGENCY\nNS RED, EW RED, Pedestrian RED\nkhông khôi phục timer cũ", fillcolor="#FECACA", penwidth=2];
  clear [label="Sự kiện thoát Emergency\nkhởi động lại an toàn", fillcolor="#E2E8F0"];
  note [shape=note, label="Quy tắc nghiệp vụ, không phải tên enum:\n- luân phiên lượt NS và EW\n- lấy mẫu density trước GREEN đã chọn\n- P được giữ và chỉ phục vụ an toàn\n- xóa P cũ khi WALK bắt đầu\n- P mới trong WALK chờ lượt sau\n- E trong YELLOW, ALL-RED hoặc WARNING được giữ\n  và xét ở điểm quyết định an toàn kế tiếp", fillcolor="#F8FAFC"];

  start -> startup;
  startup -> green [label="khởi động clearance xong"];
  green -> yellow [label="hết giờ hoặc E\n(giữ E)"];
  yellow -> allred [label="hết giờ"];
  allred -> emergencyDecision;
  emergencyDecision -> emergency [label="Có", color="#BE123C", fontcolor="#BE123C"];
  emergencyDecision -> pedestrianDecision [label="Không"];
  pedestrianDecision -> walk [label="Có"];
  pedestrianDecision -> green [label="Không: lượt xe kế tiếp"];
  walk -> warning [label="hết giờ hoặc E\n(giữ E)"];
  warning -> allred [label="hết giờ"];
  emergency -> clear [label="sự kiện thoát"];
  clear -> startup [label="bỏ countdown cũ"];
  note -> allred [style=dashed, arrowhead=none, color="#94A3B8"];
}
